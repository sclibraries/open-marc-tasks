{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open MARC Task v0.1",
  "type": "object",
  "required": ["format_version", "name", "description", "steps"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": "0.1"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "normalize_typography": {"type": "boolean", "default": false},
    "steps": {
      "type": "array",
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "required": ["leader", "in"],
      "additionalProperties": false,
      "properties": {
        "leader": {"type": "integer", "minimum": 0, "maximum": 23},
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 1}
        }
      }
    },
    "step": {
      "oneOf": [
        {"$ref": "#/$defs/delete_field_step"},
        {"$ref": "#/$defs/add_field_step"},
        {"$ref": "#/$defs/edit_subfield_step"},
        {"$ref": "#/$defs/replace_text_step"}
      ]
    },
    "delete_field_step": {
      "type": "object",
      "required": ["command", "tag"],
      "additionalProperties": false,
      "properties": {
        "command": {"const": "delete_field"},
        "tag": {"type": "string", "minLength": 3, "maxLength": 3, "pattern": "^[0-9X]{3}$"}
      }
    },
    "add_field_step": {
      "type": "object",
      "required": ["command", "tag"],
      "additionalProperties": false,
      "properties": {
        "command": {"const": "add_field"},
        "tag": {"type": "string", "minLength": 3, "maxLength": 3, "pattern": "^[0-9]{3}$"},
        "data": {"type": "string"},
        "ind1": {"type": "string", "minLength": 1, "maxLength": 1},
        "ind2": {"type": "string", "minLength": 1, "maxLength": 1},
        "subfields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {"type": "string", "minLength": 1, "maxLength": 1, "pattern": "^[a-z0-9]$"},
              {"type": "string"}
            ],
            "items": false
          }
        },
        "if_tag_exists": {"enum": ["add", "skip", "skip_if_identical"]},
        "when": {
          "type": "array",
          "items": {"$ref": "#/$defs/condition"}
        }
      },
      "oneOf": [
        {
          "required": ["data"],
          "properties": {"tag": {"pattern": "^00[0-9]$"}},
          "not": {"anyOf": [{"required": ["ind1"]}, {"required": ["ind2"]}, {"required": ["subfields"]}]}
        },
        {
          "required": ["ind1", "ind2", "subfields"],
          "not": {
            "anyOf": [
              {"required": ["data"]},
              {"required": ["tag"], "properties": {"tag": {"pattern": "^00[0-9]$"}}}
            ]
          }
        }
      ]
    },
    "edit_subfield_step": {
      "type": "object",
      "required": ["command", "tag", "code", "action"],
      "additionalProperties": false,
      "properties": {
        "command": {"const": "edit_subfield"},
        "tag": {"type": "string", "minLength": 3, "maxLength": 3, "pattern": "^[0-9]{3}$"},
        "code": {"type": "string", "minLength": 1, "maxLength": 1, "pattern": "^[a-z0-9]$"},
        "action": {"enum": ["add", "add_if_missing", "replace", "replace_first", "append", "prepend", "clear"]},
        "value": {"type": "string"},
        "find": {"type": "string", "minLength": 1},
        "replace": {"type": "string"},
        "when": {
          "type": "array",
          "items": {"$ref": "#/$defs/condition"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"action": {"enum": ["add", "add_if_missing", "append", "prepend"]}},
            "required": ["action"]
          },
          "then": {
            "required": ["value"],
            "not": {"anyOf": [{"required": ["find"]}, {"required": ["replace"]}]}
          }
        },
        {
          "if": {
            "properties": {"action": {"enum": ["replace", "replace_first"]}},
            "required": ["action"]
          },
          "then": {
            "required": ["find", "replace"],
            "not": {"required": ["value"]}
          }
        },
        {
          "if": {
            "properties": {"action": {"const": "clear"}},
            "required": ["action"]
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["value"]},
                {"required": ["find"]},
                {"required": ["replace"]}
              ]
            }
          }
        }
      ]
    },
    "replace_text_step": {
      "type": "object",
      "required": ["command", "find", "replace"],
      "additionalProperties": false,
      "properties": {
        "command": {"const": "replace_text"},
        "find": {"type": "string", "minLength": 1},
        "replace": {"type": "string"},
        "when": {
          "type": "array",
          "items": {"$ref": "#/$defs/condition"}
        }
      }
    }
  }
}
